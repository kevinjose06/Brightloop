generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  STAFF
  CUSTOMER
}

enum ProductType {
  SOFTWARE
  SERVICE
  ADDON
  PHYSICAL
}

enum BillingPeriod {
  DAILY
  WEEKLY
  MONTHLY
  YEARLY
}

enum SubscriptionStatus {
  DRAFT
  QUOTATION
  CONFIRMED
  ACTIVE
  CLOSED
}

enum PaymentTerms {
  IMMEDIATE
  NET_15
  NET_30
  NET_60
}

enum DiscountKind {
  FIXED
  PERCENT
}

enum DiscountScope {
  PRODUCT
  SUBSCRIPTION
}

enum InvoiceStatus {
  DRAFT
  CONFIRMED
  PAID
  CANCELLED
}

enum PaymentMethod {
  CASH
  CARD
  BANK_TRANSFER
  UPI
  CHEQUE
}

model User {
  id           String               @id @default(uuid())
  email        String               @unique
  passwordHash String
  role         Role                 @default(CUSTOMER)
  isActive     Boolean              @default(true)
  customerId   String?
  customer     Customer?            @relation(fields: [customerId], references: [id], onDelete: SetNull)
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
  resetTokens  PasswordResetToken[]
  auditLogs    AuditLog[]
  payments     Payment[]            @relation("RecordedPayments")

  @@index([email])
  @@index([role])
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([tokenHash])
}

model Customer {
  id            String         @id @default(uuid())
  name          String
  email         String
  phone         String?
  company       String?
  address       String?
  taxId         String?
  users         User[]
  subscriptions Subscription[]
  invoices      Invoice[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([email])
}

model Product {
  id            String                 @id @default(uuid())
  name          String
  type          ProductType            @default(SOFTWARE)
  salesPrice    Int // in paise
  costPrice     Int // in paise
  notes         String?
  isActive      Boolean                @default(true)
  variants      ProductVariant[]
  templateLines QuotationTemplateLine[]
  subLines      SubscriptionLine[]
  discounts     DiscountProduct[]
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt

  @@index([type])
  @@index([isActive])
}

model ProductVariant {
  id            String                 @id @default(uuid())
  productId     String
  product       Product                @relation(fields: [productId], references: [id], onDelete: Cascade)
  attribute     String
  value         String
  extraPrice    Int                    @default(0) // in paise
  templateLines QuotationTemplateLine[]
  subLines      SubscriptionLine[]
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt

  @@index([productId])
}

model Plan {
  id              String              @id @default(uuid())
  name            String
  price           Int // in paise
  billingPeriod   BillingPeriod       @default(MONTHLY)
  minQuantity     Int                 @default(1)
  availableFrom   DateTime
  availableTo     DateTime
  autoClose       Boolean             @default(false)
  allowEarlyClose Boolean             @default(false)
  allowPause      Boolean             @default(false)
  allowRenew      Boolean             @default(false)
  isActive        Boolean             @default(true)
  templates       QuotationTemplate[]
  subscriptions   Subscription[]
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  @@index([isActive])
  @@index([billingPeriod])
}

model QuotationTemplate {
  id            String                  @id @default(uuid())
  name          String
  validityDays  Int                     @default(30)
  planId        String
  plan          Plan                    @relation(fields: [planId], references: [id], onDelete: Restrict)
  lines         QuotationTemplateLine[]
  subscriptions Subscription[]
  createdAt     DateTime                @default(now())
  updatedAt     DateTime                @updatedAt

  @@index([planId])
}

model QuotationTemplateLine {
  id         String          @id @default(uuid())
  templateId String
  template   QuotationTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  productId  String
  product    Product         @relation(fields: [productId], references: [id], onDelete: Restrict)
  variantId  String?
  variant    ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  quantity   Int             @default(1)
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  @@index([templateId])
}

model Subscription {
  id                  String                 @id @default(uuid())
  number              String                 @unique
  customerId          String
  customer            Customer               @relation(fields: [customerId], references: [id], onDelete: Restrict)
  planId              String
  plan                Plan                   @relation(fields: [planId], references: [id], onDelete: Restrict)
  templateId          String?
  template            QuotationTemplate?     @relation(fields: [templateId], references: [id], onDelete: SetNull)
  status              SubscriptionStatus     @default(DRAFT)
  isPaused            Boolean                @default(false)
  startDate           DateTime
  expiryDate          DateTime
  nextInvoiceDate     DateTime
  paymentTerms        PaymentTerms           @default(IMMEDIATE)
  quotationValidUntil DateTime?
  createdById         String
  lines               SubscriptionLine[]
  invoices            Invoice[]
  discounts           DiscountSubscription[]
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt

  @@index([status, nextInvoiceDate])
  @@index([customerId])
  @@index([planId])
  @@index([number])
}

model SubscriptionLine {
  id             String          @id @default(uuid())
  subscriptionId String
  subscription   Subscription    @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  productId      String
  product        Product         @relation(fields: [productId], references: [id], onDelete: Restrict)
  variantId      String?
  variant        ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  quantity       Int             @default(1)
  unitPrice      Int // in paise
  taxId          String?
  taxRule        TaxRule?        @relation(fields: [taxId], references: [id], onDelete: SetNull)
  amount         Int // in paise
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([subscriptionId])
}

model TaxRule {
  id                String             @id @default(uuid())
  name              String
  ratePercent       Float // e.g. 18.0 for 18%
  productType       ProductType?
  priority          Int                @default(0)
  isActive          Boolean            @default(true)
  subscriptionLines SubscriptionLine[]
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  @@index([isActive, priority])
  @@index([productType])
}

model Discount {
  id            String                 @id @default(uuid())
  name          String
  kind          DiscountKind           @default(PERCENT)
  value         Int // paise if FIXED, or percentage integer if PERCENT (e.g. 10 for 10%)
  minPurchase   Int? // paise
  minQuantity   Int?
  startDate     DateTime
  endDate       DateTime
  usageLimit    Int?
  usedCount     Int                    @default(0)
  scope         DiscountScope          @default(SUBSCRIPTION)
  isActive      Boolean                @default(true)
  products      DiscountProduct[]
  subscriptions DiscountSubscription[]
  invoiceUses   InvoiceDiscountUse[]
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt

  @@index([startDate, endDate])
  @@index([isActive])
}

model DiscountProduct {
  id         String   @id @default(uuid())
  discountId String
  discount   Discount @relation(fields: [discountId], references: [id], onDelete: Cascade)
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([discountId, productId])
}

model DiscountSubscription {
  id             String       @id @default(uuid())
  discountId     String
  discount       Discount     @relation(fields: [discountId], references: [id], onDelete: Cascade)
  subscriptionId String
  subscription   Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@unique([discountId, subscriptionId])
}

model Invoice {
  id             String               @id @default(uuid())
  number         String               @unique
  subscriptionId String
  subscription   Subscription         @relation(fields: [subscriptionId], references: [id], onDelete: Restrict)
  customerId     String
  customer       Customer             @relation(fields: [customerId], references: [id], onDelete: Restrict)
  periodStart    DateTime
  periodEnd      DateTime
  status         InvoiceStatus        @default(DRAFT)
  issueDate      DateTime
  dueDate        DateTime
  subtotal       Int // in paise
  discountTotal  Int                  @default(0) // in paise
  taxTotal       Int                  @default(0) // in paise
  total          Int // in paise
  amountPaid     Int                  @default(0) // in paise
  sentAt         DateTime?
  lines          InvoiceLine[]
  payments       Payment[]
  discountUses   InvoiceDiscountUse[]
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  @@unique([subscriptionId, periodStart])
  @@index([status, dueDate])
  @@index([customerId])
  @@index([number])
}

model InvoiceLine {
  id             String   @id @default(uuid())
  invoiceId      String
  invoice        Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  description    String
  quantity       Int
  unitPrice      Int // in paise
  discountAmount Int      @default(0) // in paise
  taxName        String?
  taxRate        Float?
  taxAmount      Int      @default(0) // in paise
  amount         Int // in paise (unitPrice * quantity)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([invoiceId])
}

model InvoiceDiscountUse {
  id         String   @id @default(uuid())
  invoiceId  String
  invoice    Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  discountId String
  discount   Discount @relation(fields: [discountId], references: [id], onDelete: Restrict)
  amount     Int // discount amount applied in paise
  createdAt  DateTime @default(now())

  @@index([invoiceId])
  @@index([discountId])
}

model Payment {
  id           String        @id @default(uuid())
  invoiceId    String
  invoice      Invoice       @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  method       PaymentMethod @default(BANK_TRANSFER)
  amount       Int // in paise
  paidAt       DateTime      @default(now())
  note         String?
  recordedById String
  recordedBy   User          @relation("RecordedPayments", fields: [recordedById], references: [id], onDelete: Restrict)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([invoiceId, paidAt])
  @@index([recordedById])
}

model AuditLog {
  id        String   @id @default(uuid())
  actorId   String?
  actor     User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  action    String
  entity    String
  entityId  String
  meta      Json?
  at        DateTime @default(now())

  @@index([entity, entityId])
  @@index([actorId])
  @@index([at])
}

model BillingRun {
  id                      String   @id @default(uuid())
  runAt                   DateTime @default(now())
  status                  String
  subscriptionsEvaluated  Int      @default(0)
  invoicesCreated         Int      @default(0)
  skippedCount            Int      @default(0)
  failedCount             Int      @default(0)
  details                 Json?

  @@index([runAt])
}

