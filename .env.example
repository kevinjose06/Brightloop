# ==============================================================================
# BRIGHTLOOP ENVIRONMENT CONFIGURATION (SUPABASE POSTGRESQL)
# ==============================================================================

# 1. In Supabase: Go to Project Settings -> Database -> Connection string
# 2. Under "Mode: Transaction" (Port 6543) or "Mode: Session" (Port 5432):
# Copy the URI for DATABASE_URL (paste your Supabase project password in [YOUR-PASSWORD]):
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

# 3. Under "Mode: Session" (Port 5432 - Direct connection used for Prisma migrations):
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# REST API & Server Ports
PORT=5000
NODE_ENV=development
JWT_SECRET="brightloop-super-secret-jwt-key-2026-hackathon"
CORS_ORIGIN="http://localhost:5173"
LOG_LEVEL="info"

# Background Worker Cadence
CRON_SCHEDULE="*/15 * * * *"

# Mail / Notifications (Ethereal test accounts used automatically if SMTP omitted)
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
EMAIL_FROM="\"Brightloop Billing\" <billing@brightloop.io>"
APP_URL="http://localhost:5173"
