# ==============================================================================
# BRIGHTLOOP ENVIRONMENT CONFIGURATION (NO DOCKER REQUIRED)
# ==============================================================================

# Database Connection (PostgreSQL)
# Easiest for Teams: Create a free PostgreSQL database at https://neon.tech or https://supabase.com
# Paste the connection string here. The whole team can share the exact same database!
# Example: postgresql://username:password@ep-cool-flower-123456.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL="postgresql://brightloop:brightloop_password_2026@localhost:5432/brightloop_db?schema=public"

# REST API & Server Ports
PORT=5000
NODE_ENV=development
JWT_SECRET="brightloop-super-secret-jwt-key-2026-hackathon"
CORS_ORIGIN="http://localhost:5173"
LOG_LEVEL="info"

# Background Worker Cadence
CRON_SCHEDULE="*/15 * * * *"

# Mail / Notifications (Ethereal test accounts used automatically if SMTP omitted)
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
EMAIL_FROM="\"Brightloop Billing\" <billing@brightloop.io>"
APP_URL="http://localhost:5173"
