{
  "name": "brightloop",
  "version": "1.0.0",
  "private": true,
  "description": "Brightloop Enterprise Subscription Lifecycle & Billing Management Platform",
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev": "concurrently -n \"BACKEND,FRONTEND\" -c \"blue,green\" \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "npm run dev --workspace=backend",
    "dev:frontend": "npm run dev --workspace=frontend",
    "dev:worker": "npm run dev:worker --workspace=backend",
    "build": "npm run prisma:generate --workspace=backend && npm run build --workspace=backend && npm run build --workspace=frontend",
    "build:backend": "npm run build --workspace=backend",
    "build:frontend": "npm run build --workspace=frontend",
    "start": "node backend/dist/server.js",
    "test": "npm run test --workspace=backend",
    "prisma:generate": "npm run prisma:generate --workspace=backend",
    "prisma:push": "npm run prisma:push --workspace=backend",
    "prisma:seed": "npm run prisma:seed --workspace=backend",
    "prisma:benchmark": "npm run prisma:benchmark --workspace=backend"
  },
  "keywords": [
    "subscription-management",
    "billing-engine",
    "saas",
    "brightloop"
  ],
  "author": "Brightloop Team",
  "license": "MIT",
  "devDependencies": {
    "concurrently": "^10.0.6"
  }
}
